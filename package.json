{
  "name": "pg-rental",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "test": "npm test -w server",
    "test:pg": "npm run test:pg -w server",
    "test:client": "npm test -w client",
    "test:all": "npm run test:all -w server && npm run test:client",
    "migrate": "npm run migrate -w server",
    "backup:sqlite": "npm run backup:sqlite -w server",
    "dev:neon": "concurrently -k -n server,client -c blue,green \"npm run dev:neon -w server\" \"npm run dev -w client\""
  },
  "devDependencies": {
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.1",
    "concurrently": "^10.0.6"
  }
}
