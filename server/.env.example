# Backend settings. Copy this file to server/.env for local development. server/.env is ignored by git: never commit it.
# In production (Render) none of this is a file: type each value into the hosting dashboard instead (see DEPLOYMENT.md).
# Nothing in this file is ever sent to the browser.

# ---- The one owner account (REQUIRED) ----
# There is no owner sign-up page. The owner logs in with these settings; the password is stored hashed.
# Change OWNER_PASSWORD and restart the server to change the owner's password.
# If you already have an owner in the database, use that account's email to keep its data.
OWNER_EMAIL=
OWNER_PASSWORD=
# OWNER_NAME=PG Owner

# ---- Database ----
# PRODUCTION: a PostgreSQL connection string (Neon, Supabase, ...). Include ?sslmode=require. Keep it secret.
# When DATABASE_URL is set the app uses PostgreSQL; when it is not set the app uses the local SQLite file below.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Neon gives two strings: the POOLED one (host contains "-pooler") is DATABASE_URL and serves the app's normal traffic;
# the DIRECT one is DATABASE_URL_UNPOOLED and is used for schema migrations, the SQLite data copy and exports.
# `neon deploy` / `neon env pull` writes both into the project root's .env.local (git-ignored).
# DATABASE_URL_UNPOOLED=postgresql://user:password@host-without-pooler/dbname?sslmode=require
# DATABASE_POOL_MAX=5
# DATABASE_CONNECT_TIMEOUT_MS=20000
# DATABASE_SSL=disable            # only for a local PostgreSQL server that has no TLS
# DB_AUTO_MIGRATE=false           # skip the automatic schema migration at start-up (default: migrate)

# LOCAL DEVELOPMENT: path to the SQLite file, relative to the server/ folder
DB_PATH=data/pg-rental.db
# A production server refuses to start on SQLite (the file would be lost when the host restarts).
# ALLOW_SQLITE_IN_PRODUCTION=true   # only if the file is on a persistent disk

# ---- Network ----
# Port. Hosting platforms set this themselves; the server listens on 0.0.0.0:PORT.
PORT=3001

# Set to "production" on the live server (makes cookies HTTPS-only by default and disables the SQLite fallback).
# NODE_ENV=production

# Set to 1 when the app runs behind one proxy (Render, nginx, ...) so each visitor's real IP is used for rate limiting.
# TRUST_PROXY=1

# ---- Browser access (CORS and cookies) ----
# Addresses of the websites allowed to call this API, comma-separated, https, no trailing slash. Example:
#   CLIENT_ORIGINS=https://pg-rental.vercel.app
# Default in development: http://localhost:5173,http://127.0.0.1:5173. Default in production: none.
# CLIENT_ORIGINS=

# SameSite attribute of the login cookie: lax (default) | strict | none.
# Use "none" when the frontend (e.g. *.vercel.app) calls the API (e.g. *.onrender.com) directly: cookies are then sent
# across sites, so the cookie is forced to Secure and every write request must carry an allowed Origin.
# COOKIE_SAMESITE=none
# COOKIE_SECURE=false   # only to test production mode over plain http on your own computer
