# Copy this file to server/.env and fill in the owner settings. server/.env is ignored by git: never commit it.

# ---- The one owner account (REQUIRED) ----
# There is no owner sign-up page. The owner logs in with these settings; the password is stored hashed.
# Change OWNER_PASSWORD and restart the server to change the owner's password.
# If you already have an owner in the database, use that account's email to keep its data.
OWNER_EMAIL=
OWNER_PASSWORD=
# OWNER_NAME=PG Owner

# Backend port
PORT=3001

# Path to the SQLite file, relative to the server/ folder
DB_PATH=data/pg-rental.db

# Set to "production" when deploying behind HTTPS (makes the login cookie HTTPS-only)
# NODE_ENV=production

# Set to 1 if the app runs behind one reverse proxy (nginx, Render, Railway...) so client IPs are correct
# TRUST_PROXY=1

# Browser origins allowed to call the API (CORS) and to make changes, comma-separated.
# Default in development: http://localhost:5173,http://127.0.0.1:5173. Default in production: none (same-origin).
# CLIENT_ORIGINS=http://localhost:5173
