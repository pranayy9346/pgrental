# Copy this file to server/.env to change the defaults.

# Backend port
PORT=3001

# Path to the SQLite file, relative to the server/ folder
DB_PATH=data/pg-rental.db

# Set to "production" when deploying behind HTTPS (makes the login cookie HTTPS-only)
# NODE_ENV=production

# Set to 1 if the app runs behind one reverse proxy (nginx, Render, Railway...) so client IPs are correct
# TRUST_PROXY=1
